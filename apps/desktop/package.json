{
  "name": "@exograph/desktop",
  "version": "0.1.0-alpha.3",
  "description": "Open-source knowledge-graph interface and Markdown editor for working alongside terminal agents.",
  "author": "Exograph contributors",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "main": "dist/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "package:mac": "node scripts/pack-mac.mjs --mac dir",
    "dist:mac": "node scripts/pack-mac.mjs --mac dmg zip",
    "test:packaged:containment": "node scripts/run-packaged-containment.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.e2e.json --noEmit",
    "check:unused": "tsc -p tsconfig.production.json --noEmit",
    "test": "vitest run src/main src/renderer/src",
    "rebuild:native": "electron-rebuild -f -w better-sqlite3,node-pty",
    "setup:runtime": "node scripts/setup-runtime.mjs"
  },
  "dependencies": {
    "@codemirror/commands": "6.10.3",
    "@codemirror/lang-css": "6.3.1",
    "@codemirror/lang-html": "6.4.11",
    "@codemirror/lang-javascript": "6.2.5",
    "@codemirror/lang-json": "6.0.2",
    "@codemirror/lang-markdown": "6.5.0",
    "@codemirror/lang-python": "6.2.1",
    "@codemirror/lang-yaml": "6.1.3",
    "@codemirror/language": "6.12.3",
    "@codemirror/legacy-modes": "6.5.2",
    "@codemirror/lint": "6.9.5",
    "@codemirror/merge": "6.12.2",
    "@codemirror/search": "6.6.0",
    "@codemirror/state": "^6.6.0",
    "@codemirror/theme-one-dark": "6.1.3",
    "@codemirror/view": "6.38.8",
    "@exograph/core": "workspace:*",
    "@lezer/highlight": "^1.2.3",
    "@tobilu/qmd": "2.5.3",
    "@uiw/react-codemirror": "4.25.8",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-unicode11": "0.9.0",
    "@xterm/xterm": "5.5.0",
    "lucide-react": "0.577.0",
    "node-pty": "^1.1.0",
    "npm": "11.6.0",
    "pdfjs-dist": "6.2.108",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@electron/rebuild": "4.0.3",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/react-test-renderer": "19.1.0",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "41.0.2",
    "electron-vite": "5.0.0",
    "react-test-renderer": "19.2.4",
    "vite": "7.3.3"
  }
}
