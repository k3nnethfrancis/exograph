#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
export COREPACK_ENABLE_PROJECT_SPEC="${COREPACK_ENABLE_PROJECT_SPEC:-0}"

APP_DIR="${EXOGRAPH_MAC_APP_DIR:-$HOME/Applications}"
RUN_BUILD=1
DRY_RUN=0
INSTALL_CLI=0

usage() {
  cat <<'EOF'
Usage: scripts/install-mac-app [options]

Builds Exograph and installs the packaged macOS app bundle.

Options:
  --app-dir <path>      Install Exograph.app into this directory. Default: ~/Applications
  --system-app-dir      Install into /Applications.
  --skip-build          Reuse existing app and, with --with-cli, CLI build artifacts.
  --with-cli            Also install the repo-backed exo CLI shim.
  --dry-run             Print actions without changing files.
  -h, --help            Show this help.

Examples:
  ./scripts/install-mac-app
  ./scripts/install-mac-app --app-dir "$HOME/Applications"
  ./scripts/install-mac-app --system-app-dir
EOF
}

log() {
  printf '[exograph app install] %s\n' "$*"
}

run() {
  if [ "$DRY_RUN" -eq 1 ]; then
    printf '[dry-run] %q' "$1"
    shift || true
    for arg in "$@"; do
      printf ' %q' "$arg"
    done
    printf '\n'
    return 0
  fi
  "$@"
}

while [ "$#" -gt 0 ]; do
  case "$1" in
    --app-dir)
      APP_DIR="${2:-}"
      if [ -z "$APP_DIR" ]; then
        echo "Missing value for --app-dir" >&2
        exit 1
      fi
      shift 2
      ;;
    --system-app-dir)
      APP_DIR="/Applications"
      shift
      ;;
    --skip-build)
      RUN_BUILD=0
      shift
      ;;
    --with-cli)
      INSTALL_CLI=1
      shift
      ;;
    --dry-run)
      DRY_RUN=1
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      echo "Unknown option: $1" >&2
      usage >&2
      exit 1
      ;;
  esac
done

if [ "$(uname -s)" != "Darwin" ]; then
  echo "scripts/install-mac-app only supports macOS." >&2
  exit 1
fi

if ! command -v pnpm >/dev/null 2>&1; then
  echo "pnpm is required. Install it first, then rerun scripts/install-mac-app." >&2
  exit 1
fi

if [ "$RUN_BUILD" -eq 1 ]; then
  log "building packaged app bundle"
  run pnpm --dir "$REPO_ROOT" pack:mac
fi

case "$(uname -m)" in
  arm64)
    RELEASE_ARCH="mac-arm64"
    ;;
  x86_64)
    RELEASE_ARCH="mac-x64"
    ;;
  *)
    RELEASE_ARCH="mac-$(uname -m)"
    ;;
esac

APP_SOURCE="$REPO_ROOT/release/$RELEASE_ARCH/Exograph.app"
if [ ! -d "$APP_SOURCE" ]; then
  if [ "$DRY_RUN" -eq 1 ]; then
    :
  else
    echo "No packaged Exograph.app found for $RELEASE_ARCH at $APP_SOURCE. Run pnpm pack:mac on this Mac first." >&2
    exit 1
  fi
fi

APP_TARGET="$APP_DIR/Exograph.app"
APP_STAGING="$APP_DIR/.Exograph.app.install-$$"
APP_BACKUP="$APP_DIR/.Exograph.app.backup-$$"
APP_TARGET_EXISTED=0
APP_PROMOTED=0

rollback_app_replacement() {
  local status="${1:-$?}"
  trap - EXIT INT TERM
  if [ "$DRY_RUN" -eq 0 ]; then
    rm -rf "$APP_STAGING"
    if [ "$APP_TARGET_EXISTED" -eq 1 ] && [ -e "$APP_BACKUP" ]; then
      rm -rf "$APP_TARGET"
      mv "$APP_BACKUP" "$APP_TARGET" || true
    elif [ "$APP_TARGET_EXISTED" -eq 0 ] && [ "$APP_PROMOTED" -eq 1 ]; then
      rm -rf "$APP_TARGET"
    fi
    rm -rf "$APP_BACKUP"
  fi
  exit "$status"
}

log "installing app"
log "source: $APP_SOURCE"
log "target: $APP_TARGET"

run mkdir -p "$APP_DIR"
run rm -rf "$APP_STAGING" "$APP_BACKUP"
if ! run cp -R "$APP_SOURCE" "$APP_STAGING"; then
  if [ "$APP_DIR" = "/Applications" ]; then
    cat >&2 <<'EOF'

Unable to copy Exograph.app into /Applications.

Install without elevated permissions instead:
  ./scripts/install-mac-app --app-dir "$HOME/Applications"

Or rerun with the permissions your machine requires for /Applications.
EOF
  fi
  exit 1
fi

if [ "$DRY_RUN" -eq 0 ]; then
  trap 'rollback_app_replacement $?' EXIT
  trap 'rollback_app_replacement 130' INT
  trap 'rollback_app_replacement 143' TERM
fi
if [ -e "$APP_TARGET" ]; then
  APP_TARGET_EXISTED=1
  run mv "$APP_TARGET" "$APP_BACKUP"
fi
if [ "${EXOGRAPH_TEST_INTERRUPT_AFTER_BACKUP:-0}" = "1" ]; then
  kill -TERM "$$"
fi
if ! run mv "$APP_STAGING" "$APP_TARGET"; then
  exit 1
fi
APP_PROMOTED=1
run rm -rf "$APP_BACKUP"
if [ "$DRY_RUN" -eq 0 ]; then
  trap - EXIT INT TERM
fi

if [ "$INSTALL_CLI" -eq 1 ]; then
  run "$REPO_ROOT/scripts/install-local" --skip-install --skip-build
fi

cat <<EOF

Exograph macOS app install complete.

App:
  $APP_TARGET

Launch:
  open "$APP_TARGET"

After launch, Exograph should stay resident in the macOS menu bar until you choose Quit Exograph.
EOF

if [ "$INSTALL_CLI" -eq 0 ]; then
  cat <<'EOF'

Note:
  Exograph can install its bundled `exo` command from Agent access.
  Use --with-cli only when you specifically want a repo-backed developer CLI.
EOF
fi
